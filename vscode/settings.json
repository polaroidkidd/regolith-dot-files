{
    "explorer.autoReveal": false,
    "security.workspace.trust.untrustedFiles": "newWindow",
    "explorer.confirmDelete": false,
    "redhat.telemetry.enabled": false,
    "workbench.editorAssociations": {
        "*.pdf": "pdf.preview"
    },
    "npm.enableRunFromFolder": true,
    "explorer.confirmDragAndDrop": false,
    "editor.unicodeHighlight.invisibleCharacters": false,
    "[svelte]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "eslint.validate": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact"
    ],
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit",
        "source.organizeImports": "explicit"
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "svelte.plugin.svelte.defaultScriptLanguage": "ts",
    "svelte.enable-ts-plugin": true,
    "editor.minimap.enabled": false,
    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "window.customMenuBarAltFocus": false,
    "terminal.integrated.allowMnemonics": true,
    "window.enableMenuBarMnemonics": false,
    "[scss]": {
        "editor.defaultFormatter": "rvest.vs-code-prettier-eslint"
    },
    "xml.server.vmargs": "-Xmx128M",
    "[shellscript]": {
        "editor.defaultFormatter": "foxundermoon.shell-format"
    },
    "workbench.iconTheme": "vscode-icons",
    "terminal.integrated.env.linux": {},
    "[nginx]": {
        "editor.defaultFormatter": "raynigon.nginx-formatter"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "files.autoSave": "afterDelay",
    "editor.suggest.localityBonus": true,
    "editor.suggest.preview": true,
    "editor.suggest.shareSuggestSelections": true,
    "git.openRepositoryInParentFolders": "never",
    "typescript.updateImportsOnFileMove.enabled": "always",
    "[vue]": {
        "editor.defaultFormatter": "rvest.vs-code-prettier-eslint"
    },
    "playwright.reuseBrowser": false,
    "playwright.showTrace": false,
    "javascript.updateImportsOnFileMove.enabled": "always",
    "[dockercompose]": {
        "editor.defaultFormatter": "ms-azuretools.vscode-docker"
    },
    "postfix.customTemplates": [
        {
            "name": "Info",
            "body": "console.info('{{expr}}: ', {{expr}});",
            "when": []
        }
    ],
    "git-autoconfig.configList": [
        {}
    ],
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[dockerfile]": {
        "editor.defaultFormatter": "ms-azuretools.vscode-docker"
    },
    "editor.linkedEditing": true,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js, ${capture}.typegen.ts",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts, ${capture}.typegen.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml",
        "*.mts": "${capture}.typegen.ts",
        "*.cts": "${capture}.typegen.ts"
    },
    "editor.mouseWheelZoom": true,
    "eslint.ignoreUntitled": true,
    "eslint.problems.shortenToSingleLine": true,
    "eslint.format.enable": true,
    "telemetry.telemetryLevel": "off",
    "workbench.colorTheme": "Min Light",
    "terminal.integrated.enablePersistentSessions": false,
    "terminal.integrated.shellIntegration.history": 0,
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "name": "Comment",
                "scope": [
                    "comment",
                    "comment.block",
                    "comment.block.documentation",
                    "comment.line",
                    "comment.line.double-slash",
                    "punctuation.definition.comment",
                ],
                "settings": {
                    "fontStyle": "bold",
                    "foreground": "#9c57d8"
                }
            },
        ]
    },
    "editor.lineHeight": 22,
    "debug.console.fontSize": 11,
    "gitlens.views.commitDetails.files.layout": "tree",
    "vsicons.dontShowNewVersionMessage": true,
    "terminal.integrated.enableMultiLinePasteWarning": false,
    "workbench.colorCustomizations": {
        "[Min Light]": {
            "sideBar.background": "#ffffff",
            "sideBar.foreground": "#262626"
        }
    },
    "workbench.sideBar.location": "right",
    "[handlebars]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "editor.defaultColorDecorators": "auto",
    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "editor.accessibilitySupport": "off",
    "extensions.ignoreRecommendations": true,
    "update.showReleaseNotes": false,
    "prisma.showPrismaDataPlatformNotification": false,
    "github.copilot.editor.enableAutoCompletions": true,
    "git.autofetch": true,
    "gitTreeCompare.diffMode": "merge",
    "workbench.startupEditor": "none",
    "window.newWindowProfile": "Default",
    "eslint.codeActionsOnSave.rules": null,
    "scm.alwaysShowActions": true,
    "scm.alwaysShowRepositories": true,
    "scm.defaultViewMode": "tree",
    "scm.workingSets.enabled": true,
    "scm.diffDecorationsGutterPattern": {
        "added": true
    },
    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    "[mdx]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "testing.openTesting": "neverOpen",
    "supermaven.enableFixWithSupermaven": false,
    "supermaven.enableJumpSuggestions": false,
    "supermaven.enableSuggestionHighlighting": false,
    "supermaven.enableDeleteSuggestions": false,
    "testing.automaticallyOpenTestResults": "neverOpen",
    "editor.fontFamily": "'Noto Mono', 'monospace', in-terminal, 'icons-in-terminal'",
    "editor.fontLigatures": true,
    "terminal.integrated.fontFamily": "'Noto Mono', 'monospace', in-terminal, 'icons-in-terminal'",
    "terminal.integrated.gpuAcceleration": "auto",
}