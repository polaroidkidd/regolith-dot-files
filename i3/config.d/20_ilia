# Load stylesheet if exists
set_from_resource $ilia.stylesheet ilia.stylesheet

## Launch // Application // <> Space ##
#set_from_resource $wm.binding.launcher.app i3-wm.binding.launcher.app space
set_from_resource $wm.program.launcher.app i3-wm.program.launcher.app ilia -p apps
bindsym $mod+Tab exec --no-startup-id $wm.program.launcher.app -t $ilia.stylesheet

## Launch // Command // <><Shift> Space ##
# set_from_resource $wm.binding.launcher.cmd i3-wm.binding.launcher.cmd Shift+space
# set_from_resource $wm.program.launcher.cmd i3-wm.program.launcher.cmd ilia -p terminal
# bindsym $mod+Shift+x exec --no-startup-id $wm.program.launcher.cmd -t $ilia.stylesheet

## Launch // Keybinding Viewer // <><Shift> ? ##
set_from_resource $wm.binding.help i3-wm.binding.help Shift+question
set_from_resource $wm.program.help i3-wm.program.help ilia -p keybindings
bindsym $mod+$wm.binding.help exec --no-startup-id $wm.program.help -a -t $ilia.stylesheet

## Navigate // Window by Name // <><Ctrl> Space ##
set_from_resource $wm.binding.launcher.window i3-wm.binding.launcher.window Ctrl+space
set_from_resource $wm.program.launcher.window i3-wm.program.launcher.window ilia -p windows
bindsym $mod+$wm.binding.launcher.window exec --no-startup-id $wm.program.launcher.window -t $ilia.stylesheet

## Launch // File Search // <><Alt> Space ##
set_from_resource $wm.binding.file_search i3-wm.binding.file_search space
set_from_resource $wm.program.file_search i3-wm.program.file_search ilia -p tracker
bindsym $mod+$alt+$wm.binding.file_search exec --no-startup-id $wm.program.file_search -t $ilia.stylesheet

## Launch // Look Selector // <><Alt> l ##
set_from_resource $wm.binding.look_selector i3-wm.binding.look_selector l
set_from_resource $wm.program.look_selector i3-wm.program.look_selector regolith-look-selector
bindsym $mod+$alt+$wm.binding.look_selector exec --no-startup-id $wm.program.look_selector -t $ilia.stylesheet
