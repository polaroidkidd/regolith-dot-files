{
  "files.watcherExclude": {
    "**/volumes": true,
    "**/node_modules": true,
  },
  "explorer.autoReveal": false,
  "security.workspace.trust.untrustedFiles": "newWindow",
  "explorer.confirmDelete": false,
  "redhat.telemetry.enabled": false,
  "workbench.editorAssociations": {
    "*.pdf": "pdf.preview"
  },
  "npm.enableRunFromFolder": true,
  "explorer.confirmDragAndDrop": false,
  "editor.unicodeHighlight.invisibleCharacters": false,
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode"
  },
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "[typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "svelte.plugin.svelte.defaultScriptLanguage": "ts",
  "svelte.enable-ts-plugin": true,
  "editor.minimap.enabled": false,
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "window.customMenuBarAltFocus": false,
  "terminal.integrated.allowMnemonics": true,
  "window.enableMenuBarMnemonics": false,
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "xml.server.vmargs": "-Xmx128M",
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  "terminal.integrated.env.linux": {},
  "[nginx]": {
    "editor.defaultFormatter": "raynigon.nginx-formatter"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "files.autoSave": "afterDelay",
  "editor.suggest.localityBonus": true,
  "editor.suggest.preview": true,
  "editor.suggest.shareSuggestSelections": true,
  "git.openRepositoryInParentFolders": "never",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "[vue]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "playwright.reuseBrowser": false,
  "playwright.showTrace": false,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "[dockercompose]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-docker"
  },
  "postfix.customTemplates": [
    {
      "name": "Info",
      "body": "console.info('{{expr}}: ', {{expr}});",
      "when": []
    }
  ],
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-docker"
  },
  "editor.linkedEditing": true,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js, ${capture}.typegen.ts",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts, ${capture}.typegen.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml",
    "*.mts": "${capture}.typegen.ts",
    "*.cts": "${capture}.typegen.ts"
  },
  "editor.mouseWheelZoom": true,
  "eslint.ignoreUntitled": true,
  "eslint.problems.shortenToSingleLine": true,
  "eslint.format.enable": true,
  "telemetry.telemetryLevel": "off",
  "workbench.colorTheme": "Min Light",
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.shellIntegration.history": 0,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "name": "Comment",
        "scope": [
          "comment",
          "comment.block",
          "comment.block.documentation",
          "comment.line",
          "comment.line.double-slash",
          "punctuation.definition.comment"
        ],
        "settings": {
          "fontStyle": "bold",
          "foreground": "#9c57d8"
        }
      }
    ]
  },
  "editor.lineHeight": 22,
  "debug.console.fontSize": 11,
  "gitlens.views.commitDetails.files.layout": "tree",
  "terminal.integrated.enableMultiLinePasteWarning": "auto",
  "workbench.colorCustomizations": {
    "[Min Light]": {
      "sideBar.background": "#ffffff",
      "sideBar.foreground": "#262626"
    }
  },
  "workbench.sideBar.location": "right",
  "[handlebars]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "editor.defaultColorDecorators": "auto",
  "[javascriptreact]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "editor.accessibilitySupport": "off",
  "extensions.ignoreRecommendations": true,
  "update.showReleaseNotes": false,
  "prisma.showPrismaDataPlatformNotification": false,
  "github.copilot.editor.enableAutoCompletions": true,
  "git.autofetch": true,
  "gitTreeCompare.diffMode": "merge",
  "workbench.startupEditor": "none",
  "window.newWindowProfile": "Default",
  "eslint.codeActionsOnSave.rules": null,
  "scm.alwaysShowActions": true,
  "scm.alwaysShowRepositories": true,
  "scm.defaultViewMode": "tree",
  "scm.workingSets.enabled": true,
  "scm.diffDecorationsGutterPattern": {
    "added": true
  },
  "[mdx]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "testing.openTesting": "neverOpen",
  "testing.automaticallyOpenTestResults": "neverOpen",
  "editor.fontFamily": "'Noto Mono', 'monospace', in-terminal, 'icons-in-terminal'",
  "editor.fontLigatures": true,
  "terminal.integrated.fontFamily": "'Noto Mono', 'monospace', in-terminal, 'icons-in-terminal'",
  "terminal.integrated.gpuAcceleration": "auto",
  "tabnine.experimentalAutoImports": true,
  "remote.defaultExtensionsIfInstalledLocally": [
    "GitHub.copilot",
    "GitHub.copilot-chat",
    "GitHub.vscode-pull-request-github"
  ],
  "workbench.hover.delay": 2000,
  "[postcss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma"
  },
  "gitweblinks.gitLabEnterprise": [
    {
      "http": "https://gitlab.ti8m.ch",
      "ssh": "ssh://gitlab.ti8m.ch"
    }
  ],
  "git.blame.editorDecoration.enabled": true,
  "git.blame.ignoreWhitespace": true,
  "claudeCode.preferredLocation": "panel",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "chat.disableAIFeatures": true,
  "remote.SSH.experimental.chat": false,
  "terminal.integrated.initialHint": false,
  "editor.largeFileOptimizations": false,
  "settingsSync.ignoredExtensions": [
    "anthropic.claude-code"
  ],
  "docker.extension.enableComposeLanguageServer": false,
  "workbench.tips.enabled": false,
  "yaml.hoverAnchor": false,
  "yaml.hover": false,
  "files.trimTrailingWhitespaceInRegexAndStrings": false,
  "editor.formatOnSave": true,
  "workbench.editor.restoreViewState": false,
  "hediet.vscode-drawio.resizeImages": null,
  "diffEditor.ignoreTrimWhitespace": false,
  "files.associations": {
    "*.css": "css"
  },
}